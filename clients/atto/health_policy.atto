// Source-level, pure AttoLang admission policy. Does not perform HTTP or JSON parsing.
// All facts are explicitly supplied by a trusted host; flags do not grant authority.
define module flags_2_env_client as
  pub fnc can_accept_health(int status, bool transport_ok,
                            bool within_response_budget, bool decoded_json,
                            bool health_ok, bool service_nonempty): bool {
    return status == 200 && transport_ok && within_response_budget &&
      decoded_json && health_ok && service_nonempty;
  }

  pub fnc can_forward_bearer(bool token_requested, bool token_nonempty,
                            bool transport_secure, bool same_origin): bool {
    return token_requested && token_nonempty && transport_secure && same_origin;
  }

  pub fnc self_check(): bool {
    return can_accept_health(200, true, true, true, true, true) &&
      !can_accept_health(201, true, true, true, true, true) &&
      !can_accept_health(200, true, false, true, true, true) &&
      !can_accept_health(200, true, true, true, false, true) &&
      can_forward_bearer(true, true, true, true) &&
      !can_forward_bearer(true, true, false, true) &&
      !can_forward_bearer(true, true, true, false);
  }
end
